<header>
  {% comment %} Language detection: pages without a lang are treated as Russian {% endcomment %}
  {% assign current_lang = page.lang | default: 'ru' %}
  {% if current_lang == 'en' %}
    {% assign home_url = '/en/' %}
  {% else %}
    {% assign home_url = '/' %}
  {% endif %}
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% assign about_title = '' %}
          {% for pg in site.pages %}
            {% if pg.permalink == home_url %} {% assign about_title = pg.title %} {% endif %}
          {% endfor %}
          {% if about_title == '' %}
            {% if current_lang == 'en' %}{% assign about_title = 'Home' %}{% else %}{% assign about_title = 'Главная' %}{% endif %}
          {% endif %}

          <!-- About / Home -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- about_title }}
              {% if page.permalink == home_url %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: 'ru' %}
            {% if p.nav and p.autogen == null and p_lang == current_lang %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                <li class="nav-item {% if page.url contains p.permalink %}active{% endif %}">
                  {% if p.nav_url %}{% assign url = p.nav_url %}{% elsif p.permalink contains '/blog/' %}{% if current_lang == 'en' %}{% assign url = '/en/blog/' %}{% else %}{% assign url = '/blog/' %}{% endif %}{% else %}{% assign url = p.url %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
              </button>
            </li>
          {% endif %}

          <!-- Language toggle -->
          {% if current_lang == 'en' %}
            {% assign lang_target = page.lang_ref | default: '/' %}
            {% assign lang_label = 'RU' %}
            {% assign lang_title = 'Русская версия' %}
          {% else %}
            {% assign lang_target = page.lang_ref | default: '/en/' %}
            {% assign lang_label = 'EN' %}
            {% assign lang_title = 'English version' %}
          {% endif %}
          <li class="nav-item lang-toggle-item">
            <a class="nav-link lang-toggle" href="{{ lang_target | relative_url }}" title="{{ lang_title }}" aria-label="{{ lang_title }}">
              {{- lang_label -}}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
